{
  "name": "AKA Executive Dashboard",
  "short_name": "AKA Dashboard",
  "description": "Executive production, sales, inventory and project reporting dashboard.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f6f8",
  "theme_color": "#17365d",
