  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/aka-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/aka-app-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/",
      "icons": [{ "src": "/aka-app-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Excel Deploy",
      "short_name": "Excel",
      "url": "/report-publisher",
      "icons": [{ "src": "/aka-app-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
